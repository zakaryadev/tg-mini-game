# Telegram bot tokeni (@BotFather). Production'da MAJBURIY: initData shu token bilan tekshiriladi.
BOT_TOKEN=
# Bot username (@siz) va Mini App qisqa nomi: taklif havolasi uchun
# https://t.me/<BOT_USERNAME>/<APP_SHORT_NAME>?startapp=<XONA_KODI>
BOT_USERNAME=
APP_SHORT_NAME=
# Ilovaning ochiq HTTPS manzili (tunnel yoki hosting). Berilsa, bot menyu tugmasi va /start avtomatik sozlanadi
PUBLIC_URL=
PORT=3001
# production da NODE_ENV=production qiling: dev-kirish avtomatik o'chadi
NODE_ENV=development
# Faqat sinov uchun: barcha kutish vaqtlarini qisqartirish (masalan 0.25)
# TIME_SCALE=1
